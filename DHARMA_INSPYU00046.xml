      <body>
			<div type="edition" xml:lang="pli-Latn" rendition="class:83227 maturity:83211">
				<pb n="1r"/><label>First leaf (Or5340A)</label>
					<!-- Or5340A before Or5340B unless B is meant to be read before A -->
					<p><lb n="1r1"/>
						<g ref="sym:bar-ornate"/><g ref="sym:bullet-triple"/><g ref="sym:bar-ornate"/>
						ye
						dhammā
						hetupabhavā
						<space/>
						tesaṁ
						hetu<supplied reason="omitted">ṁ</supplied>
						tathāgato
						<space/>
						Āha
						tesañ
						ca
						yo
						nirodho
						<space/>
						Evaṁvādi
						mahāsamano
						ti
						<g ref="sym:doubleBar" type="punctuation">.</g>
						cattāro
						Iddhipādā
						<lb n="2"/>
						cattāro
						sammappadhānā
						<space/>
						cattāro
						satipaṭṭhānā
						<space/>
						cattāri
						Ariyasaccāni
						<space/>
						catuves<supplied reason="omitted">ā</supplied>rajjāni 
						<space/>
						pañcindriyāni
						<space/>
						pañcacakkhūni
						<space/>
						cha<lb n="3" break="no"/>Asaddhāraṇ<unclear>ā</unclear>ni 
						<space/>
						sattabojjhaṅgā
						<space/>
						Ariyo
						Aṭṭhiṅgiko
						maggo
						<space/>
						navalokuttarā
						dhammā
						<space/>
						dasabal<supplied reason="omitted">ā</supplied>ni
						<space/>
						cundasa
						buddhaññāni
						Aṭṭhārasabuddhadhammāni
					</p>
				<pb n="2r"/><label>Second leaf (Or5340B)</label>
					<p>
						<lb n="1"/>
						<g ref="sym:doubleBar" type="punctuation">.</g>
						ye
						dhammā
						hetupabhavā
						<space/>
						tesa<supplied reason="omitted">ṁ</supplied>
						hetu<supplied reason="omitted">ṁ</supplied>
						tathāgato
						Āha
						<space/>
						tesañ
						ca
						yo
						nirodho
						<space/>
						Evaṁvādi
						mahāsama<unclear>n</unclear>o
						ti
						<space/>
						Iti
						pi
						so
						bhagavā
						Arahaṁ
						<lb n="2"/>
						sammāsaṁbuddho
						<space/>
						vijjācaraṇasappanno
						<space/>
						sugato
						lokavidu
						<space/>
						Anuttaro
						purisadammasārathī
						<space/>
						satthā
						devamanussānaṁ
						<space/>
						buddho
						bhagavā
						ti
						<lb n="3"/>
						svākhyāto
						bhagavatā
						dhammo
						<space/>
						sandiṭṭhiko
						<space/>
						Akāl<supplied reason="omitted">i</supplied>ko
						<space/>
						Ehipassiko
						<space/>
						<supplied reason="lost">O</supplied>paṇāyiko
						<space/>
						paccattaṁ
						veditavvo
						<space/>
						viññūhī
						ti
						<g ref="sym:bar-ornate"/><g ref="sym:bullet-triple"/><g ref="sym:bar-ornate"/>
					</p>
				
			</div>
			<div type="apparatus">
				<listApp><!-- Finot 1912 readings still need to be collated -->
					<app loc="1r1">
						<lem><g ref="sym:bar-ornate"/><g ref="sym:bullet-triple"/><g ref="sym:bar-ornate"/></lem>
						<rdg source="bib:TunNyein1898-99_01"><g ref="sym:doubleBar"/></rdg>
<!-- same opening/cvlosing mark surrounding triple dot and vertical bars as in PYU 39 -->
						<note>The opening mark stands in the margin; the same sign is repeated atthe end of leaf 2. It is a simpler version of the one seen at the end of <ref target="DHARMA_INSPYU00044">PYU 44</ref>.</note>
					</app>
					<app loc="1r1">
						<lem>tesañ ca</lem>
						<note>There is a rightward curl at the top of the vertical element in &lt;ñ&gt;, that could possibly be interpreted as &lt;-ā&gt;, but we assume it is a somewhat overdone serif.</note>
					</app>
					<app loc="1r1">
						<lem>Evaṁvādi mahāsamano</lem>
						<note>The expected form would be <foreign xml:lang="pli-Latn">Evaṁvādī mahāsamaṇo</foreign>. Same irregularities in leaf 2.</note>
					</app>
					<app loc="1r2">
						<lem>satipaṭṭhānā</lem>
						<rdg source="bib:TunNyein1898-99_01">satipaṭṭhāuā</rdg>
						<note>(misprint)</note>
					</app>
					<app loc="1r2">
						<lem>Ariyasaccāni</lem>
						<rdg source="bib:TunNyein1898-99_01">Ariyasacohāni</rdg>
						<note>(misprint)</note>
					</app>
					<app loc="1r3">
						<lem>Asaddhāraṇ<unclear>ā</unclear>ni</lem>
						<note>Tun Nyein corrects <foreign xml:lang="pli-Latn">Asādhāraṇāni </foreign> in note.</note>
					</app>
					<app loc="1r3">
						<lem>Aṭṭhiṅgiko</lem>
						<note>Tun Nyein corrects <foreign xml:lang="pli-Latn">Aṭṭhaṅgiko</foreign> in note.</note>
					</app>
					<app loc="1r3">
						<lem>dasabal<supplied reason="omitted">ā</supplied>ni</lem>
						<note>Tun Nyein silently corrects <foreign xml:lang="pli-Latn">dasabalāni</foreign>.</note>
					</app>
					<app loc="1r3">
						<lem>cundasa</lem>
						<note>Tun Nyein silently corrects <foreign xml:lang="pli-Latn">cuddasa</foreign>.</note>
					</app>
					<app loc="1r3">
						<lem>buddhaññāni</lem>
						<rdg source="bib:TunNyein1898-99_01">buddhakoni</rdg>
						<note>correcting <foreign xml:lang="pli-Latn">buddhayonī</foreign> in note; emend <foreign xml:lang="pli-Latn">buddhañāṇāni</foreign>.</note>
					</app>
					<app loc="2r1">
						<lem><g ref="sym:doubleBar" type="punctuation">.</g></lem>
						<note>The two bars are connected by a small cross-bar.</note>
					</app>
					<app loc="2r1">
						<lem>Evaṁvādi mahāsamano</lem>
						<note>The expected form would be <foreign xml:lang="pli-Latn">Evaṁvādī mahāsamaṇo</foreign>. Same irregularities in leaf 1.</note>
					</app>
					<app loc="2r2">
						<lem>-sappanno</lem>
						<note>Tun Nyein corrects <foreign xml:lang="pli-Latn">-sampanno</foreign> in note.</note>
					</app>
					<app loc="2r2">
						<lem>-sārathī</lem>
						<rdg source="bib:TunNyein1898-99_01">-sārathi</rdg>
					</app>
					<app loc="2r3">
						<lem>Akāl<supplied reason="omitted">i</supplied>ko</lem>
						<rdg source="bib:TunNyein1898-99_01">Akāliko</rdg>
						<note>Silent correction.</note>
					</app>
					<app loc="2r3">
						<lem><supplied reason="lost">O</supplied>paṇāyiko</lem>
						<note>Tun Nyein corrects <foreign>Opanayiko</foreign> in note. Editions of the canon show either <foreign>Opaneyyika</foreign> or <foreign>Opanāyiko</foreign>.</note>
					</app>
					<app loc="2r3">
						<lem><g ref="sym:bar-ornate"/><g ref="sym:bullet-triple"/><g ref="sym:bar-ornate"/></lem>
						<rdg source="bib:TunNyein1898-99_01">||</rdg>
						<note>The closing sign here corresponds to the opening sign of leaf 1, and reveals that the two leaves form one whole.</note>
					</app>
				</listApp>
			</div>
